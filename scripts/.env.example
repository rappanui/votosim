# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SERVICE_ROLE_KEY=eyJ...service-role-key...

# ─── Election year (required by ingest-tse and ingest-party-programs) ─────────
ELECTION_YEAR=2026

# ─── AI Provider Chain ────────────────────────────────────────────────────────
# At least one provider key is required to run enrichment scripts.
# The chain tries providers left-to-right, falling through on 429 or error.
# All providers use 70B+ models — no quality degradation on fallback.
# Default order: groq,deepseek,cerebras
#
# AI_PROVIDER_ORDER=groq,deepseek,cerebras

# Provider 1 — Groq (primary; fast inference; ~100K tokens/day, 30 RPM free)
# Signup: https://console.groq.com
# Default model: llama-3.3-70b-versatile
# Override: GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=gsk_...

# Provider 2 — DeepSeek (secondary; excellent multilingual; limited free credits on signup)
# Signup: https://platform.deepseek.com
# Default model: deepseek-chat (V3)
# Override: DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=sk-...

# Provider 3 — Cerebras (tertiary; generous free tier; fast inference)
# Signup: https://cloud.cerebras.ai
# Default model: llama-3.3-70b
# Override: CEREBRAS_MODEL=llama-3.3-70b
# CEREBRAS_API_KEY=csk-...
